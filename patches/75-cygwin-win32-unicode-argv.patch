 #if defined(__CYGWIN__)
+static wchar_t *win32_widen_arg(const char *arg)
+{
+	mbstate_t state;
+	const char *src;
+	size_t need;
+	wchar_t *wide;
+	int utf8_need;
+
+	/* Respect an explicitly selected Cygwin multibyte locale first. */
+	memset(&state, 0, sizeof(state));
+	src = arg;
+	need = mbsrtowcs(NULL, &src, 0, &state);
+	if (need != (size_t) -1) {
+		wide = malloc((need + 1) * sizeof(*wide));
+		if (wide == NULL)
+			return NULL;
+		memset(&state, 0, sizeof(state));
+		src = arg;
+		if (mbsrtowcs(wide, &src, need + 1, &state) != (size_t) -1)
+			return wide;
+		free(wide);
+	}
+
+	/*
+	 * Cygwin uses UTF-8 internally for Windows filename conversion even for
+	 * ASCII C/POSIX locales. A caller may therefore carry UTF-8 argv bytes
+	 * that the C locale cannot decode. Fall back to strict UTF-8 rather than
+	 * silently replacing characters.
+	 */
+	utf8_need = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+		arg, -1, NULL, 0);
+	if (utf8_need <= 0)
+		return NULL;
+	wide = malloc((size_t) utf8_need * sizeof(*wide));
+	if (wide == NULL)
+		return NULL;
+	if (0 == MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+		arg, -1, wide, utf8_need)) {
+		free(wide);
+		return NULL;
+	}
+	return wide;
+}
