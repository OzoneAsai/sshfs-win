+struct conn_features {
+	struct conn *conn;
+	int connver;
+	uint32_t server_version;
+	int ext_posix_rename;
+	int ext_statvfs;
+	int ext_hardlink;
+};
+
+/*
+ * Select and, if necessary, establish one connection while holding the same
+ * lock that protects generation changes. The returned feature snapshot is
+ * therefore tied to connver and must be used with sftp_request_gen().
+ */
+static int get_conn_features(struct conn_features *features, int ensure_connected)
+{
+	struct conn *conn;
+	int err = 0;
+
+	pthread_mutex_lock(&sshfs.lock);
+	conn = get_conn_locked(NULL, NULL);
+	if (ensure_connected)
+		err = start_processing_thread(conn);
+	if (!err) {
+		features->conn = conn;
+		features->connver = conn->connver;
+		features->server_version = conn->server_version;
+		features->ext_posix_rename = conn->ext_posix_rename;
+		features->ext_statvfs = conn->ext_statvfs;
+		features->ext_hardlink = conn->ext_hardlink;
+	}
+	pthread_mutex_unlock(&sshfs.lock);
+	return err;
+}
