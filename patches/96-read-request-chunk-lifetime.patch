 static void sshfs_read_begin(struct request *req)
 {
 	struct read_req *rreq = (struct read_req *) req->data;
+
+	/*
+	 * A submitted READ owns the chunk until its completion callback has
+	 * finished.  The cached/read-call reference may disappear independently
+	 * (for example when release() drops an in-flight readahead chunk), so the
+	 * request itself must keep the callback state alive.
+	 */
+	rreq->chunk->refs++;
 	rreq->sio->num_reqs++;
 }
 
