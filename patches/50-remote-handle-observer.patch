+struct remote_handle_warning {
+	int emit;
+	unsigned conn_index;
+	unsigned tracked;
+	unsigned peak;
+	unsigned warning_step;
+};
+
+/*
+ * Account SFTP handle replies while sshfs.lock is held. request_type is the
+ * original SFTP opcode, so asynchronous CLOSE requests are covered too.
+ * No logging is performed under sshfs.lock; a snapshot is returned to the
+ * caller for emission after unlocking.
+ */
+static void remote_handle_account_reply_locked(
+	struct request *req, uint8_t reply_type, const struct buffer *reply,
+	struct remote_handle_warning *warning)
+{
+	struct conn *conn = req->conn;
+	int creates_handle = 0;
+	int closes_handle = 0;
+	unsigned old_count;
+
+	if (req->request_type == SSH_FXP_OPEN ||
+	    req->request_type == SSH_FXP_OPENDIR) {
+		creates_handle = reply_type == SSH_FXP_HANDLE;
+	} else if (req->request_type == SSH_FXP_CLOSE) {
+		struct buffer status_reply = *reply;
+		uint32_t status;
+
+		if (reply_type == SSH_FXP_STATUS &&
+		    buf_get_uint32(&status_reply, &status) != -1 &&
+		    status == SSH_FX_OK)
+			closes_handle = 1;
+	} else {
+		return;
+	}
+
+	if (!creates_handle && !closes_handle)
+		return;
+
+	old_count = conn->remote_handles;
+	if (creates_handle) {
+		conn->remote_handles++;
+		if (conn->remote_handles > conn->remote_handle_peak)
+			conn->remote_handle_peak = conn->remote_handles;
+
+		if (sshfs.handle_warn != 0 &&
+		    conn->remote_handles / sshfs.handle_warn >
+		    old_count / sshfs.handle_warn) {
+			warning->emit = 1;
+			warning->conn_index = (unsigned)(conn - sshfs.conns);
+			warning->tracked = conn->remote_handles;
+			warning->peak = conn->remote_handle_peak;
+			warning->warning_step = sshfs.handle_warn;
+		}
+	} else if (conn->remote_handles != 0) {
+		conn->remote_handles--;
+	}
+}
+
+static void remote_handle_log_warning(const struct remote_handle_warning *warning)
+{
+	if (!warning->emit)
+		return;
+
+	fprintf(stderr,
+		"sshfs: remote-handle-observer connection=%u "
+		"tracked=%u peak=%u warning_step=%u\n",
+		warning->conn_index, warning->tracked, warning->peak,
+		warning->warning_step);
+}
