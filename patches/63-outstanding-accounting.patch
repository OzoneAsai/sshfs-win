 /*
+ * Release one request's in-flight byte ownership. Caller holds sshfs.lock.
+ * The ownership bit makes reply, send-failure, teardown and final-destroy
+ * paths idempotent. An underflow means request ownership is corrupted, so
+ * fail closed rather than silently unblocking I/O with a false byte count.
+ */
+static void request_release_outstanding_locked(struct request *req)
+{
+	if (!req->outstanding_accounted)
+		return;
+
+	if (req->len > sshfs.outstanding_len) {
+		fprintf(stderr,
+			"sshfs: outstanding byte accounting invariant failed "
+			"request=%u len=%llu tracked=%llu\n",
+			req->id, (unsigned long long)req->len,
+			(unsigned long long)sshfs.outstanding_len);
+		abort();
+	}
+
+	sshfs.outstanding_len -= req->len;
+	req->outstanding_accounted = 0;
+
+	/* Any reduction may make room for a request waiting at admission. */
+	if (sshfs.max_outstanding_len != (size_t)-1)
+		pthread_cond_broadcast(&sshfs.outstanding_cond);
+}
