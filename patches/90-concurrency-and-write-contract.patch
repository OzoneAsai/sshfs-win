+static int sshfs_write_reply_error(struct request *req)
+{
+	uint32_t serr;
+
+	if (req->error)
+		return req->error;
+	if (!req->replied) {
+		fprintf(stderr, "write request completed without a reply\n");
+		return -EIO;
+	}
+	if (req->reply_type != SSH_FXP_STATUS) {
+		fprintf(stderr, "protocol error: write reply is not STATUS\n");
+		return -EIO;
+	}
+	if (buf_get_uint32(&req->reply, &serr) == -1) {
+		fprintf(stderr, "protocol error: malformed write STATUS reply\n");
+		return -EIO;
+	}
+	if (serr != SSH_FX_OK)
+		return -sftp_error_to_errno(serr);
+	return 0;
+}
