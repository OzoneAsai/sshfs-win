--- a/sshfs.c
+++ b/sshfs.c
@@ -3716,6 +3716,13 @@
 	// Commutes with pending write(), so we can use any connection
 	err = sftp_request(get_conn(NULL, NULL), SSH_FXP_REMOVE, &buf, SSH_FXP_STATUS, NULL);
 	buf_free(&buf);
+
+	if (!err && sshfs.max_conns > 1) {
+		/* The pathname no longer names the inode owned by this affinity. */
+		pthread_mutex_lock(&sshfs.lock);
+		g_hash_table_remove(sshfs.conntab, path);
+		pthread_mutex_unlock(&sshfs.lock);
+	}
 	return err;
 }
 
@@ -3808,12 +3815,25 @@
 		err = -EXDEV;
 
 	if (!err && sshfs.max_conns > 1 && strcmp(from, to) != 0) {
-		/* rename(path, path) is a remote no-op; preserve local affinity. */
+		struct conntab_entry *to_ce;
+
+		/* Identical pathname strings are excluded by the outer condition. */
 		pthread_mutex_lock(&sshfs.lock);
 		ce = g_hash_table_lookup(sshfs.conntab, from);
+		to_ce = g_hash_table_lookup(sshfs.conntab, to);
