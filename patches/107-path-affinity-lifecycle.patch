-			g_hash_table_replace(sshfs.conntab, g_strdup(to), ce);
-			g_hash_table_remove(sshfs.conntab, from);
+			/*
+			 * POSIX rename is also a no-op when both names are hard links
+			 * to the same inode. CP31-S makes that identity visible by
+			 * mapping both aliases to the same conntab entry.
+			 */
+			if (!(used_posix_ext && to_ce == ce)) {
+				g_hash_table_replace(sshfs.conntab, g_strdup(to), ce);
+				g_hash_table_remove(sshfs.conntab, from);
+			}
+		} else {
+			/* Destination now names another inode; discard stale affinity. */
+			g_hash_table_remove(sshfs.conntab, to);
 		}
 		pthread_mutex_unlock(&sshfs.lock);
 	}
