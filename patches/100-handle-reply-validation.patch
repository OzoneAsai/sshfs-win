 /*
+ * SSH_FXP_HANDLE contains exactly one SFTP string after the request id. Type
+ * correctness alone is not enough: reject a truncated length field, payload
+ * length mismatch or trailing garbage before accepting the handle.
+ */
+static int sftp_handle_reply_valid(const struct buffer *reply)
+{
+	struct buffer copy = *reply;
+	uint32_t handle_len;
+
+	if (copy.len > copy.size ||
+	    buf_get_uint32(&copy, &handle_len) == -1 ||
+	    handle_len != copy.size - copy.len)
+		return 0;
+	return 1;
+}
+
