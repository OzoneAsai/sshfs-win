+struct startup_status {
+	int stage;
+	int errnum;
+};
+
+static void startup_report_failure(int fd, int stage, int errnum)
+{
+	struct startup_status status = { stage, errnum ? errnum : EIO };
+	const char *p = (const char *)&status;
+	size_t left = sizeof(status);
+
+	while (left != 0) {
+		ssize_t n = write(fd, p, left);
+		if (n > 0) {
+			p += n;
+			left -= (size_t)n;
+			continue;
+		}
+		if (n == -1 && errno == EINTR)
+			continue;
+		break;
+	}
+}
+
+static const char *startup_stage_name(int stage)
+{
+	switch (stage) {
+	case 1: return "redirect-stdio";
+	case 2: return "second-fork";
+	case 3: return "chdir";
+	case 4: return "unset-OLDPWD";
+	case 5: return "setsid";
+	case 6: return "open-pty";
+	case 7: return "exec";
+	default: return "unknown";
+	}
+}
+
+static int startup_read_status(int fd, struct startup_status *status)
+{
+	char *p = (char *)status;
+	size_t used = 0;
+
+	while (used < sizeof(*status)) {
+		ssize_t n = read(fd, p + used, sizeof(*status) - used);
+		if (n > 0) {
+			used += (size_t)n;
+			continue;
+		}
+		if (n == 0)
+			return used == 0 ? 0 : -2;
+		if (errno == EINTR)
+			continue;
+		return -1;
+	}
+	return 1;
+}
+
+static void startup_parent_cleanup(struct conn *conn)
+{
+	int rfd = conn->rfd;
+	int wfd = conn->wfd;
+
+	if (rfd != -1)
+		close(rfd);
+	if (wfd != -1 && wfd != rfd)
+		close(wfd);
+	conn->rfd = -1;
+	conn->wfd = -1;
+
+	if (sshfs.ptyfd != -1) {
+		close(sshfs.ptyfd);
+		sshfs.ptyfd = -1;
+	}
+	if (sshfs.ptypassivefd != -1) {
+		close(sshfs.ptypassivefd);
+		sshfs.ptypassivefd = -1;
+	}
+}
