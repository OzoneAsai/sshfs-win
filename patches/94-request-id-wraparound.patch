+/*
+ * Allocate an ID for a request that will enter reqtab. Caller holds
+ * sshfs.lock, so the lookup and the later insertion are one allocation
+ * transaction. The wire ID is only 32 bits; after wraparound we must skip
+ * IDs that are still owned by in-flight requests instead of replacing their
+ * hash-table entries.
+ */
+static int sftp_get_request_id_locked(uint32_t *idp)
+{
+	uint32_t first;
+	uint32_t id;
+
+	first = sftp_get_id();
+	id = first;
+	while (g_hash_table_lookup(sshfs.reqtab, GUINT_TO_POINTER(id)) != NULL) {
+		id = sftp_get_id();
+		if (id == first)
+			return -EAGAIN;
+	}
+	*idp = id;
+	return 0;
+}
