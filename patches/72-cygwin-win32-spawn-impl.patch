+#if defined(__CYGWIN__)
+static int win32_quote_warg(const wchar_t *arg, wchar_t **outp)
+{
+	size_t i, n = wcslen(arg), outlen = 2; /* surrounding quotes */
+	wchar_t *out, *q;
+
+	for (i = 0; i < n;) {
+		size_t bs = 0;
+		while (i < n && arg[i] == L'\\') {
+			bs++;
+			i++;
+		}
+		if (i == n) {
+			outlen += bs * 2;
+			break;
+		}
+		if (arg[i] == L'"')
+			outlen += bs * 2 + 2; /* escaped slashes + escaped quote */
+		else
+			outlen += bs + 1;
+		i++;
+	}
+
+	out = malloc((outlen + 1) * sizeof(*out));
+	if (out == NULL)
+		return -1;
+	q = out;
+	*q++ = L'"';
+	for (i = 0; i < n;) {
+		size_t bs = 0, j;
+		while (i < n && arg[i] == L'\\') {
+			bs++;
+			i++;
+		}
+		if (i == n) {
+			for (j = 0; j < bs * 2; j++)
+				*q++ = L'\\';
+			break;
+		}
+		if (arg[i] == L'"') {
+			for (j = 0; j < bs * 2 + 1; j++)
+				*q++ = L'\\';
+			*q++ = L'"';
+		} else {
+			for (j = 0; j < bs; j++)
+				*q++ = L'\\';
+			*q++ = arg[i];
+		}
+		i++;
+	}
+	*q++ = L'"';
+	*q = L'\0';
+	*outp = out;
+	return 0;
+}
+
+static wchar_t *win32_command_line(char *const argv[], int argc)
+{
+	wchar_t **quoted = calloc((size_t) argc, sizeof(*quoted));
+	wchar_t *cmd = NULL;
+	size_t total = 1;
+	int i;
+
+	if (quoted == NULL)
+		return NULL;
+	for (i = 0; i < argc; i++) {
+		size_t need = mbstowcs(NULL, argv[i], 0);
+		wchar_t *wide;
+		if (need == (size_t) -1)
+			goto out;
+		wide = malloc((need + 1) * sizeof(*wide));
+		if (wide == NULL)
+			goto out;
+		if (mbstowcs(wide, argv[i], need + 1) == (size_t) -1) {
+			free(wide);
+			goto out;
+		}
+		if (win32_quote_warg(wide, &quoted[i]) == -1) {
+			free(wide);
+			goto out;
+		}
+		free(wide);
+		total += wcslen(quoted[i]) + (i != 0);
+	}
+	cmd = calloc(total, sizeof(*cmd));
+	if (cmd == NULL)
+		goto out;
+	for (i = 0; i < argc; i++) {
+		if (i != 0)
+			wcscat(cmd, L" ");
+		wcscat(cmd, quoted[i]);
+	}
+
+out:
+	for (i = 0; i < argc; i++)
+		free(quoted[i]);
+	free(quoted);
+	return cmd;
+}
+
+static HANDLE inheritable_stderr(void)
+{
+	SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, TRUE };
+	HANDLE result = INVALID_HANDLE_VALUE;
+
+	if (sshfs.foreground) {
+		intptr_t raw = _get_osfhandle(STDERR_FILENO);
+		if (raw != -1 && raw != (intptr_t) INVALID_HANDLE_VALUE &&
+		    DuplicateHandle(GetCurrentProcess(), (HANDLE) raw,
+				    GetCurrentProcess(), &result, 0, TRUE,
+				    DUPLICATE_SAME_ACCESS))
+			return result;
+	}
+	return CreateFileW(L"NUL", GENERIC_WRITE,
+			   FILE_SHARE_READ | FILE_SHARE_WRITE, &sa,
+			   OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+}
+
+static int start_ssh_win32(struct conn *conn)
+{
+	SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, TRUE };
+	STARTUPINFOEXW si;
+	PROCESS_INFORMATION pi;
+	HANDLE child_stdin = INVALID_HANDLE_VALUE;
+	HANDLE parent_write = INVALID_HANDLE_VALUE;
+	HANDLE parent_read = INVALID_HANDLE_VALUE;
+	HANDLE child_stdout = INVALID_HANDLE_VALUE;
+	HANDLE child_stderr = INVALID_HANDLE_VALUE;
+	HANDLE inherit_list[3];
+	SIZE_T attr_size = 0;
+	wchar_t *application = NULL, *cmdline = NULL, *cwd = NULL;
+	int rfd = -1, wfd = -1, result = -1;
+	int attr_initialized = 0;
+	DWORD create_error = ERROR_SUCCESS;
+
+	memset(&si, 0, sizeof(si));
+	memset(&pi, 0, sizeof(pi));
+	si.StartupInfo.cb = sizeof(si);
+
+	if (!CreatePipe(&child_stdin, &parent_write, &sa, 0) ||
+	    !CreatePipe(&parent_read, &child_stdout, &sa, 0)) {
+		create_error = GetLastError();
+		goto out;
+	}
+	if (!SetHandleInformation(parent_write, HANDLE_FLAG_INHERIT, 0) ||
+	    !SetHandleInformation(parent_read, HANDLE_FLAG_INHERIT, 0)) {
+		create_error = GetLastError();
+		goto out;
+	}
+	child_stderr = inheritable_stderr();
+	if (child_stderr == INVALID_HANDLE_VALUE) {
+		create_error = GetLastError();
+		goto out;
+	}
+
+	/* Transfer the parent pipe ends into Cygwin fd ownership. */
+	rfd = cygwin_attach_handle_to_fd("/dev/piper", -1, parent_read,
+					 O_BINARY, GENERIC_READ);
+	if (rfd < 0)
+		goto out;
+	parent_read = INVALID_HANDLE_VALUE;
+	wfd = cygwin_attach_handle_to_fd("/dev/pipew", -1, parent_write,
+					 O_BINARY, GENERIC_WRITE);
+	if (wfd < 0)
+		goto out;
+	parent_write = INVALID_HANDLE_VALUE;
+
+	application = cygwin_create_path(CCP_POSIX_TO_WIN_W,
+					sshfs.ssh_args.argv[0]);
+	cwd = cygwin_create_path(CCP_POSIX_TO_WIN_W, "/");
+	cmdline = win32_command_line(sshfs.ssh_args.argv, sshfs.ssh_args.argc);
+	if (application == NULL || cwd == NULL || cmdline == NULL)
+		goto out;
+
+	inherit_list[0] = child_stdin;
+	inherit_list[1] = child_stdout;
+	inherit_list[2] = child_stderr;
+	InitializeProcThreadAttributeList(NULL, 1, 0, &attr_size);
+	if (attr_size == 0) {
+		create_error = GetLastError();
+		goto out;
+	}
+	si.lpAttributeList = HeapAlloc(GetProcessHeap(), 0, attr_size);
+	if (si.lpAttributeList == NULL) {
+		create_error = ERROR_NOT_ENOUGH_MEMORY;
+		goto out;
+	}
+	if (!InitializeProcThreadAttributeList(si.lpAttributeList, 1, 0,
+					       &attr_size)) {
+		create_error = GetLastError();
+		goto out;
+	}
+	attr_initialized = 1;
+	if (!UpdateProcThreadAttribute(si.lpAttributeList, 0,
+				       PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
+				       inherit_list, sizeof(inherit_list),
+				       NULL, NULL)) {
+		create_error = GetLastError();
+		goto out;
+	}
+
+	si.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+	si.StartupInfo.hStdInput = child_stdin;
+	si.StartupInfo.hStdOutput = child_stdout;
+	si.StartupInfo.hStdError = child_stderr;
+
+	if (sshfs.debug)
+		fprintf(stderr, "executing SSH via forkless Win32 CreateProcessW\n");
+	if (!CreateProcessW(application, cmdline, NULL, NULL, TRUE,
+			    EXTENDED_STARTUPINFO_PRESENT, NULL, cwd,
+			    &si.StartupInfo, &pi)) {
+		create_error = GetLastError();
+		goto out;
+	}
+
+	/* The WinFsp job owns process lifetime; no POSIX child/zombie is created. */
+	CloseHandle(pi.hThread);
+	CloseHandle(pi.hProcess);
+	pi.hThread = NULL;
+	pi.hProcess = NULL;
+	conn->rfd = rfd;
+	conn->wfd = wfd;
+	rfd = -1;
+	wfd = -1;
+	result = 0;
+
+out:
+	if (si.lpAttributeList != NULL) {
+		if (attr_initialized)
+			DeleteProcThreadAttributeList(si.lpAttributeList);
+		HeapFree(GetProcessHeap(), 0, si.lpAttributeList);
+	}
+	if (pi.hThread != NULL)
+		CloseHandle(pi.hThread);
+	if (pi.hProcess != NULL)
+		CloseHandle(pi.hProcess);
+	if (child_stdin != INVALID_HANDLE_VALUE)
+		CloseHandle(child_stdin);
+	if (child_stdout != INVALID_HANDLE_VALUE)
+		CloseHandle(child_stdout);
+	if (child_stderr != INVALID_HANDLE_VALUE)
+		CloseHandle(child_stderr);
+	if (parent_read != INVALID_HANDLE_VALUE)
+		CloseHandle(parent_read);
+	if (parent_write != INVALID_HANDLE_VALUE)
+		CloseHandle(parent_write);
+	if (rfd >= 0)
+		close(rfd);
+	if (wfd >= 0)
+		close(wfd);
+	free(application);
+	free(cmdline);
+	free(cwd);
+	if (result != 0) {
+		if (create_error != ERROR_SUCCESS)
+			fprintf(stderr, "failed to create SSH process: Win32 error %lu\n",
+				(unsigned long) create_error);
+		else
+			perror("failed to create SSH process");
+	}
+	return result;
+}
+#endif
